# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — never commit real keys.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → Data API / API Keys
# Both of these are safe to expose in the browser. Row Level Security is what
# protects the data, which is why 0002_rls.sql matters so much.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# The public URL of this site. Used to build the email confirmation and
# password-reset links. Leave it as localhost while developing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The service_role key bypasses every RLS policy — only lib/supabase/service.ts
# reads it, and only the Stripe webhook route uses that file. Never prefix it
# with NEXT_PUBLIC_, and never import service.ts from a Server Action, page,
# or component that acts on a signed-in user's behalf.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Stripe (Connect payouts, checkout, Identity verification) — optional. The
# app works fine with these blank; every payment/verification screen just
# shows "not turned on yet" instead of talking to Stripe. See README § 2.5.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
