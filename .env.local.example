# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — never commit real keys.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → Data API / API Keys
# Both of these are safe to expose in the browser. Row Level Security is what
# protects the data, which is why 0002_rls.sql matters so much.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# The public URL of this site. Used to build the email confirmation and
# password-reset links. Leave it as localhost while developing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# NEVER put the service_role key in this file or anywhere in the Next.js app.
# It bypasses every RLS policy. It belongs only in a server-only environment
# (a Supabase Edge Function or a server env var that is never prefixed with
# NEXT_PUBLIC_), and this project does not need it yet.
# ---------------------------------------------------------------------------
