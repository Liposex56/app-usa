# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — never commit real keys.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → Data API / API Keys
# Both of these are safe to expose in the browser. Row Level Security is what
# protects the data, which is why 0002_rls.sql matters so much.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# The public URL of this site. Used to build the email confirmation and
# password-reset links. Leave it as localhost while developing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The service_role key bypasses every RLS policy — only lib/supabase/service.ts
# reads it, and only the Stripe webhook route uses that file. Never prefix it
# with NEXT_PUBLIC_, and never import service.ts from a Server Action, page,
# or component that acts on a signed-in user's behalf.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Stripe (Connect payouts, checkout, Identity verification) — optional. The
# app works fine with these blank; every payment/verification screen just
# shows "not turned on yet" instead of talking to Stripe. See README § 2.5.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Criminal background checks (Checkr) — optional. Without a key the Havener
# page says automatic checks aren't turned on and staff record the result by
# hand in /dashboard/admin/background-checks. The key also signs the webhook
# (/api/checkr/webhook). See README § "Verificación: identidad vs. antecedentes".
# ---------------------------------------------------------------------------
CHECKR_API_KEY=
CHECKR_PACKAGE=tasker_standard
# CHECKR_API_BASE=https://api.checkr-staging.com/v1

# ---------------------------------------------------------------------------
# Notification emails (Resend) — optional. Without these, notifications still
# appear inside the app (the bell); nothing is emailed. CRON_SECRET protects
# /api/cron/emails, which Vercel calls every day (vercel.json) — Vercel sends
# it as `Authorization: Bearer $CRON_SECRET`, so set the same value there.
# EMAIL_FROM must use a domain you verified in Resend.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
CRON_SECRET=
